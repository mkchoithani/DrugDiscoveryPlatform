{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dmta",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "dmta.api:app",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "deck",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8777",
        "--directory",
        "deck"
      ],
      "port": 8777
    }
  ]
}
