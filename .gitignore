# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Regenerable data. Each of these is rebuilt by a documented command, so none
# belongs in git. (Comments go on their own line: git treats a trailing "#" as
# part of the pattern, which silently ignores nothing at all.)
#   data/*.csv        -> python3 -m dmta.cli chembl-fetch --target <id>
#   data/structures/  -> python3 -m dmta.cli structure --pdb <id>
#   data/poses/       -> python3 dock_validate.py <pdb> <n>
data/*.csv
data/structures/
data/poses/
data/docking_cache.json
campaigns.db
*.db

# The COVID Moonshot master file is 87 MB; the trimmed extract is committed instead.
sample_data/covid_moonshot.csv
sample_data/osm_compounds.sdf

# Generated reports and worklists
*-report.html
worklist-*.csv
ui/reports/

# macOS
.DS_Store

# Downloaded papers (copyright stays with the publishers)
papers/
